# ============================================================
# Contracts Environment Variables (for redeployment only)
# The vault is already deployed — users don't need this!
# ============================================================

# Only needed if you want to redeploy the contract yourself
# PRIVATE_KEY=your_private_key_here

# Optional: override default RPC
# INJECTIVE_TESTNET_RPC=https://k8s.testnet.json-rpc.injective.network/
