# Injective testnet by default; mainnet: https://sentry.evm-rpc.injective.network/
RPC_URL=https://k8s.testnet.json-rpc.injective.network/

# Funded EOA for swap/deploy targets (testnet faucet: https://testnet.faucet.injective.network/)
PRIVATE_KEY=

# Input token (ERC20 address) and spot market id. Defaults in the Makefile
# point at testnet USDT and the INJ/USDT market.
# TOKEN_IN=
# MARKET_ID=
# AMOUNT_IN=10000000

# Deployed SwapDemo address for `make demo-swap`
# DEMO_ADDR=
