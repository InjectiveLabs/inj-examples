# ===========================
# Injective EVM (testnet)
# ===========================

# EVM JSON-RPC
RPC_URL=https://k8s.testnet.json-rpc.injective.network/
# Native endpoints (testnet)
LCD_URL=https://testnet.sentry.lcd.injective.network:443
TM_URL=https://testnet.sentry.tm.injective.network:443
CHAIN_ID=injective-888

# LayerZero EndpointV2 on Injective EVM testnet (eid 40408). Mainnet (eid 30394): 0x6f475642a6e85809b1c36fa62763669b1b48dd5b
LZ_ENDPOINT=0x3acaaf60502791d199a5a5f0b173d78229ebfe32

# Deployer key. The same key signs on the EVM (0x) and native (inj1) side.
PRIVATE_KEY=
WALLET_ADDRESS=
INJ_ADDRESS=
# Key name in the injectived keyring, imported with:
#   injectived keys unsafe-import-eth-key <name> <PRIVATE_KEY without 0x> --keyring-backend file
INJ_KEY_NAME=oft-deployer

# ===========================
# Token
# ===========================
TOKEN_NAME=Example OFT
TOKEN_SYMBOL=XOFT
TOKEN_DECIMALS=6

# Path A (native first): tokenfactory subdenom, up to 44 alphanumeric characters
SUBDENOM=xoft
# Initial supply minted in the atomic tx, in base units (1_000_000 XOFT at 6 decimals)
INITIAL_SUPPLY=1000000000000

# Set after `make create-native-token` (Path A). The ERC20 the adapter wraps.
MTS_ERC20_ADDRESS=

# Set after `make deploy-adapter` (Path A) or `make deploy-oft` (Path B).
# This is the OApp address that goes into layerzero.config.ts.
OAPP_ADDRESS=

# Path B only: INJ sent with the deployment, debited for the 1 INJ denom creation fee on first mint.
DEPLOY_VALUE=1ether

# ===========================
# Solana side (from the LayerZero oft-solana example)
# ===========================
# OFT Store public key (base58) printed by `lz:oft:solana:create`
SOLANA_OFT_STORE=
# 40168 = Solana devnet, 30168 = Solana mainnet
SOLANA_EID=40168
