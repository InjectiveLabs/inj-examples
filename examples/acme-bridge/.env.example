# ===========================
# Ethereum Sepolia
# ===========================

# Sepolia RPC endpoint (public, or use Alchemy/QuickNode for reliability)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Your private key (same key works for Sepolia and Injective EVM)
PRIVATE_KEY=

# Your 0x wallet address
WALLET_ADDRESS=

# ===========================
# Deploy
# ===========================

# Set after deploying ACME on Sepolia (make deploy-sepolia)
ACME_ADDRESS=

# ===========================
# Bridge
# ===========================

# Peggy bridge contract on Sepolia (do not change)
PEGGY_CONTRACT=0x69A8b9F6e25b8D2550C3abc41E84929feaA2CBAF

# Amount to bridge (in wei, 18 decimals)
# 1000 ACME = 1000000000000000000000
BRIDGE_AMOUNT=1000000000000000000000

# ===========================
# Injective Testnet
# ===========================

# Injective EVM RPC
RPC_URL=https://k8s.testnet.json-rpc.injective.network/

# Your inj1... address (corresponds to the same private key as WALLET_ADDRESS)
INJ_ADDRESS=

# Key name in injectived keyring (for create-token-pair)
# Import with: injectived keys unsafe-import-eth-key acme-test
INJ_KEY_NAME=acme-test

# ===========================
# MTS Token Pair
# ===========================

# Set after creating the MTS token pair (make create-pair)
MTS_ERC20_ADDRESS=
